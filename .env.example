# BOT CONFIG (majburiy - bo'sh qoldirmang)
# BOT_TOKEN: @BotFather dan olingan token (bo'shliq bo'lmasin)
BOT_TOKEN=123456:ABC-your-token-here
# PRIMARY_ADMIN: bitta integer Telegram ID
PRIMARY_ADMIN=123456789
# ADMINS: qo'shimcha adminlar, vergul bilan, bo'shliqsiz (ixtiyoriy bo'lishi mumkin, bo'sh qoldirsa bo'ladi)
ADMINS=123456789
# CHANNELS: ixtiyoriy, hozircha ishlatilmaydi
CHANNELS=

# CRYPTO API URLS (ixtiyoriy - ko'rsatilmasa built-in default ishlaydi)
# Defaults:
#   https://api.coinbase.com/v2/prices
#   https://api.binance.com/api/v3/ticker/price
#   https://api.coingecko.com/api/v3/simple/price
COINBASE_BASE_URL=
BINANCE_URL=
COINGECKO_URL=

# FIAT RATES API (ixtiyoriy - ko'rsatilmasa built-in default ishlaydi)
# Defaults:
#   https://cbu.uz/uz/arkhiv-kursov-valyut/json/
#   https://www.cbr-xml-daily.ru/daily_json.js
#   https://open.er-api.com/v6/latest/USD (ER_API_URL, zaxira manba)
UZS_RATE_URL=
RUB_RATE_URL=
ER_API_URL=

# COINGECKO (optional free demo key -> higher rate limits, fewer throttled ticks)
COINGECKO_API_KEY=

# COINMARKETCAP (ixtiyoriy - kalit bo'lmasa bu manba o'tkazib yuboriladi)
COINMARKETCAP_API_KEY=
COINMARKETCAP_URL=
